# Production Environment Configuration
NODE_ENV=production

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database is configured through environment variables in production
# PGUSER, PGPASSWORD, PGDATABASE, PGHOST, PGPORT and DATABASE_URL
# are all set in the deployment environment

# Security Configuration
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRY=86400 # 24 hours in seconds

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=60000 # 1 minute in milliseconds

# Caching
CACHE_TTL=300 # 5 minutes in seconds

# Logging
LOG_LEVEL=info

# API keys for external services
# OPENAI_API_KEY is set in the deployment environment
# SLACK_BOT_TOKEN is set in the deployment environment (if using Slack integration)
# SLACK_CHANNEL_ID is set in the deployment environment (if using Slack integration)